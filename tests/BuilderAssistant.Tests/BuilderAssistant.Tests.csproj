<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>BuilderAssistant.Tests</AssemblyName>
    <RootNamespace>BuilderAssistant.Tests</RootNamespace>
    <!-- Core + Generators are game-agnostic, so this runner proves the build
         engine offline (no Survivalcraft.dll needed). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\CellPos.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Safety\WorldBounds.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Safety\BuildSafetyLimits.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Safety\TerrainAuthority.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Blueprints\BlockOrientation.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Blueprints\BlueprintCell.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Blueprints\Blueprint.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Blueprints\BlueprintBuilder.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Blueprints\BuildingMaterials.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Json\Json.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Blueprints\BlueprintJson.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Blueprints\BlueprintLibraryBrowser.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Blueprints\BlueprintImportService.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Blueprints\BlueprintNamePolicy.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Transactions\ITerrainGateway.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Transactions\IBlockValueResolver.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Transactions\BlockUndoRecord.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Transactions\CellEditability.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\BuildEngine\BuildPlan.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\BuildEngine\BuildPlanner.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\BuildEngine\BuildTaskState.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\BuildEngine\BuildTask.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\BuildEngine\TransactionHistory.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Features\Generators\GenerationContext.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Features\Generators\IBuildingGenerator.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Features\Generators\BuildingGeneratorRegistry.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Features\Generators\MedievalCottageGenerator.cs" />
    <!-- Parametric generation engine (game-free Core/Building + adapters). The whole
         BuildingSpec -> BuildingComposer -> Blueprint pipeline and its validator run here
         with no Survivalcraft.dll, which is exactly what lets us prove determinism, budget
         rejection and structural QC offline before touching the live palette/terrain layer. -->
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\BuildingEnums.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\DeterministicRandom.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\MaterialCatalog.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\MaterialProfile.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\BuildingSpec.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\BuildingContext.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\IBuildingComponent.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\FoundationGenerator.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\WallGenerator.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\StairGenerator.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\OpeningGenerator.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\FloorPlanGenerator.cs" />
    <Compile Include="..\..\src\BuilderAssistant\Core\Building\RoofGenerator.cs" />
