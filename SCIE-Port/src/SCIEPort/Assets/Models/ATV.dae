<?xml version="1.0" encoding="utf-8"?>
<!-- Project-created, deliberately low-poly ATV: one body cuboid plus four wheel cuboids. -->
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset><unit name="meter" meter="1"/><up_axis>Y_UP</up_axis></asset>
  <library_geometries>
    <geometry id="ATV-Cube-mesh" name="ATV-Cube">
      <mesh>
        <source id="ATV-Cube-positions"><float_array id="ATV-Cube-positions-array" count="24">-0.5 -0.5 -0.5 0.5 -0.5 -0.5 0.5 0.5 -0.5 -0.5 0.5 -0.5 -0.5 -0.5 0.5 0.5 -0.5 0.5 0.5 0.5 0.5 -0.5 0.5 0.5</float_array><technique_common><accessor source="#ATV-Cube-positions-array" count="8" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source>
        <source id="ATV-Cube-normals"><float_array id="ATV-Cube-normals-array" count="18">0 0 -1 0 0 1 -1 0 0 1 0 0 0 -1 0 0 1 0</float_array><technique_common><accessor source="#ATV-Cube-normals-array" count="6" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source>
        <source id="ATV-Cube-uv"><float_array id="ATV-Cube-uv-array" count="8">0 0 1 0 1 1 0 1</float_array><technique_common><accessor source="#ATV-Cube-uv-array" count="4" stride="2"><param name="S" type="float"/><param name="T" type="float"/></accessor></technique_common></source>
        <vertices id="ATV-Cube-vertices"><input semantic="POSITION" source="#ATV-Cube-positions"/></vertices>
        <triangles count="12"><input semantic="VERTEX" source="#ATV-Cube-vertices" offset="0"/><input semantic="NORMAL" source="#ATV-Cube-normals" offset="1"/><input semantic="TEXCOORD" source="#ATV-Cube-uv" offset="2" set="0"/><p>0 0 0 1 0 1 2 0 2 0 0 0 2 0 2 3 0 3 4 1 0 6 1 2 5 1 1 4 1 0 7 1 3 6 1 2 0 2 0 3 2 3 7 2 2 0 2 0 7 2 2 4 2 1 1 3 0 5 3 1 6 3 2 1 3 0 6 3 2 2 3 3 0 4 0 4 4 1 5 4 2 0 4 0 5 4 2 1 4 3 3 5 0 2 5 1 6 5 2 3 5 0 6 5 2 7 5 3</p></triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes><visual_scene id="Scene" name="Scene">
    <node id="ATVBody" name="ATVBody" type="NODE"><matrix sid="transform">1.3 0 0 0 0 0.42 0 0 0 0 1.85 0 0 0.65 0 1</matrix><instance_geometry url="#ATV-Cube-mesh"/></node>
    <node id="ATVWheelFrontLeft" name="ATVWheelFrontLeft" type="NODE"><matrix sid="transform">0.36 0 0 0 0 0.36 0 0 0 0 0.30 0 -0.9 0.34 -0.78 1</matrix><instance_geometry url="#ATV-Cube-mesh"/></node>
    <node id="ATVWheelFrontRight" name="ATVWheelFrontRight" type="NODE"><matrix sid="transform">0.36 0 0 0 0 0.36 0 0 0 0 0.30 0 0.9 0.34 -0.78 1</matrix><instance_geometry url="#ATV-Cube-mesh"/></node>
    <node id="ATVWheelRearLeft" name="ATVWheelRearLeft" type="NODE"><matrix sid="transform">0.36 0 0 0 0 0.36 0 0 0 0 0.30 0 -0.9 0.34 0.78 1</matrix><instance_geometry url="#ATV-Cube-mesh"/></node>
    <node id="ATVWheelRearRight" name="ATVWheelRearRight" type="NODE"><matrix sid="transform">0.36 0 0 0 0 0.36 0 0 0 0 0.30 0 0.9 0.34 0.78 1</matrix><instance_geometry url="#ATV-Cube-mesh"/></node>
  </visual_scene></library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
